	Text = "Player information", TextColor3 = Color3.fromRGB(245, 247, 252), Font = Enum.Font.GothamBold,
	TextSize = 17, TextXAlignment = Enum.TextXAlignment.Left,
})
local info = create("TextBox", sidebar, {
	Position = UDim2.fromOffset(16, 86), Size = UDim2.new(1, -32, 0, 206), BackgroundColor3 = Color3.fromRGB(23, 30, 42),
	Text = "No drawing selected.\n\nReview a webhook TXT file to display the player's username, display name, user ID, place, and timestamps.",
