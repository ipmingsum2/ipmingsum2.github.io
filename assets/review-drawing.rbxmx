				<ProtectedString name="Source"><![CDATA[-- Save the ServerStorage.WhiteboardViewer folder as a Local Plugin.
-- This script must run in plugin context.

local StudioService = game:GetService("StudioService")
local HttpService = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local toolbar = plugin:CreateToolbar("Alvin's Creationz Staff")
local toolbarButton = toolbar:CreateButton("OpenWhiteboardLog", "Open a whiteboard TXT log", "rbxassetid://4458901886", "Whiteboard Logs")
toolbarButton.ClickableWhenViewportHidden = true

local previousGui = CoreGui:FindFirstChild("WhiteboardViewerScreen")
if previousGui then previousGui:Destroy() end

local widget = Instance.new("ScreenGui")
widget.Name = "WhiteboardViewerScreen"
widget.IgnoreGuiInset = true
widget.ResetOnSpawn = false
widget.DisplayOrder = 1000000
widget.ZIndexBehavior = Enum.ZIndexBehavior.Global
widget.Enabled = false
widget.Parent = CoreGui

local function create(className, parent, properties)
	local object = Instance.new(className)
	for key, value in pairs(properties or {}) do object[key] = value end
	object.Parent = parent
	return object
end

