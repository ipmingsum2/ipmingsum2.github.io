create("UIStroke", info, {Color = Color3.fromRGB(59, 73, 96), Transparency = 0.5, Thickness = 1})
create("UIPadding", info, {
	PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14),
})
local statusCard = create("Frame", sidebar, {
	Position = UDim2.fromOffset(16, 308), Size = UDim2.new(1, -32, 0, 92), BackgroundColor3 = Color3.fromRGB(13, 33, 47), BorderSizePixel = 0,
})
create("UICorner", statusCard, {CornerRadius = UDim.new(0, 13)})
create("UIStroke", statusCard, {Color = Color3.fromRGB(34, 112, 150), Transparency = 0.45, Thickness = 1})
create("TextLabel", statusCard, {
	Position = UDim2.fromOffset(14, 12), Size = UDim2.new(1, -28, 0, 18), BackgroundTransparency = 1,
	Text = "STATUS", TextColor3 = Color3.fromRGB(81, 190, 231), Font = Enum.Font.GothamBold, TextSize = 10,
	TextXAlignment = Enum.TextXAlignment.Left,
})
local status = create("TextLabel", statusCard, {
	Position = UDim2.fromOffset(14, 34), Size = UDim2.new(1, -28, 0, 45), BackgroundTransparency = 1,
	Text = "Ready to review a downloaded webhook TXT.", TextColor3 = Color3.fromRGB(201, 219, 232),
	Font = Enum.Font.Gotham, TextSize = 12, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
	TextYAlignment = Enum.TextYAlignment.Top,
})
create("TextLabel", sidebar, {
	AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 18, 1, -18), Size = UDim2.new(1, -36, 0, 64), BackgroundTransparency = 1,
	Text = "Coordinates and colors are reconstructed locally. No AI moderation is used.",
	TextColor3 = Color3.fromRGB(116, 130, 151), Font = Enum.Font.Gotham, TextSize = 11, TextWrapped = true,
	TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Bottom,
})

local previewHolder = create("Frame", body, {
	Position = UDim2.fromOffset(318, 0), Size = UDim2.new(1, -318, 1, 0),
	BackgroundColor3 = Color3.fromRGB(16, 22, 32), BackgroundTransparency = 0.02, BorderSizePixel = 0,
})
create("UICorner", previewHolder, {CornerRadius = UDim.new(0, 16)})
create("UIStroke", previewHolder, {Color = Color3.fromRGB(52, 63, 81), Transparency = 0.4, Thickness = 1})
create("TextLabel", previewHolder, {
	Position = UDim2.fromOffset(20, 16), Size = UDim2.new(1, -40, 0, 25), BackgroundTransparency = 1,
	Text = "Drawing Preview", TextColor3 = Color3.fromRGB(245, 247, 252), Font = Enum.Font.GothamBold,
	TextSize = 17, TextXAlignment = Enum.TextXAlignment.Left,
})
create("TextLabel", previewHolder, {
	Position = UDim2.fromOffset(20, 42), Size = UDim2.new(1, -40, 0, 20), BackgroundTransparency = 1,
	Text = "Faithful reconstruction of submitted coordinates and colors", TextColor3 = Color3.fromRGB(127, 141, 163),
	Font = Enum.Font.Gotham, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
})
local previewWell = create("Frame", previewHolder, {
	Position = UDim2.fromOffset(18, 76), Size = UDim2.new(1, -36, 1, -126),
	BackgroundColor3 = Color3.fromRGB(9, 13, 20), BorderSizePixel = 0, ClipsDescendants = true,
})
create("UICorner", previewWell, {CornerRadius = UDim.new(0, 13)})
create("UIStroke", previewWell, {Color = Color3.fromRGB(49, 59, 75), Transparency = 0.45, Thickness = 1})
local emptyState = create("TextLabel", previewWell, {
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -60, 0, 72),
	BackgroundTransparency = 1, Text = "NO DRAWING LOADED\nSelect Review Drawing to choose a TXT log.",
	TextColor3 = Color3.fromRGB(111, 126, 149), Font = Enum.Font.GothamBold, TextSize = 13, TextWrapped = true,
})
local canvas = create("Frame", previewWell, {
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(100, 82),
	BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ClipsDescendants = true, Visible = false,
})
create("UICorner", canvas, {CornerRadius = UDim.new(0, 4)})
local ownerTooltip = create("TextLabel", previewWell, {
	AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 12), Size = UDim2.fromOffset(430, 38),
	BackgroundColor3 = Color3.fromRGB(17, 25, 38), BackgroundTransparency = 0.04, BorderSizePixel = 0,
	Text = "", TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold, TextSize = 13,
	TextTruncate = Enum.TextTruncate.AtEnd, Visible = false, ZIndex = 10000,
})
create("UICorner", ownerTooltip, {CornerRadius = UDim.new(0, 10)})
create("UIStroke", ownerTooltip, {Color = Color3.fromRGB(84, 111, 158), Transparency = 0.3, Thickness = 1})
local footer = create("TextLabel", previewHolder, {
	AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 20, 1, -12), Size = UDim2.new(1, -40, 0, 24), BackgroundTransparency = 1,
	Text = "No log loaded", TextColor3 = Color3.fromRGB(126, 140, 161), Font = Enum.Font.Gotham, TextSize = 11,
	TextXAlignment = Enum.TextXAlignment.Left,
})

local currentAspect = 1000 / 823
local function fitCanvas()
	local available = previewWell.AbsoluteSize - Vector2.new(36, 36)
	local maxWidth, maxHeight = math.max(1, available.X), math.max(1, available.Y)
	local width, height
	if maxWidth / maxHeight > currentAspect then
		height = maxHeight
		width = height * currentAspect
	else
		width = maxWidth
		height = width / currentAspect
	end
	canvas.Size = UDim2.fromOffset(math.floor(width), math.floor(height))
end
previewWell:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() task.defer(fitCanvas) end)
task.defer(fitCanvas)

local hoverInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
importButton.MouseEnter:Connect(function()
	TweenService:Create(importButton, hoverInfo, {
		BackgroundColor3 = Color3.fromRGB(61, 111, 248), Size = UDim2.fromOffset(184, 44),
	}):Play()
end)
importButton.MouseLeave:Connect(function()
	TweenService:Create(importButton, hoverInfo, {
		BackgroundColor3 = Color3.fromRGB(45, 91, 230), Size = UDim2.fromOffset(178, 42),
	}):Play()
end)
closeButton.MouseEnter:Connect(function()
	TweenService:Create(closeButton, hoverInfo, {
		BackgroundColor3 = Color3.fromRGB(128, 48, 58), TextColor3 = Color3.new(1, 1, 1),
	}):Play()
end)
closeButton.MouseLeave:Connect(function()
	TweenService:Create(closeButton, hoverInfo, {
		BackgroundColor3 = Color3.fromRGB(29, 36, 49), TextColor3 = Color3.fromRGB(190, 200, 215),
	}):Play()
end)

local lastMotion = 0
UserInputService.InputChanged:Connect(function(input)
	if not widget.Enabled or input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
	if os.clock() - lastMotion < 1 / 45 then return end
	lastMotion = os.clock()
	local size = root.AbsoluteSize
	if size.X <= 0 or size.Y <= 0 then return end
	local relative = Vector2.new(input.Position.X, input.Position.Y) - root.AbsolutePosition
	local x = math.clamp((relative.X / size.X - 0.5) * 2, -1, 1)
	local y = math.clamp((relative.Y / size.Y - 0.5) * 2, -1, 1)
	headerBar.Position = UDim2.fromOffset(24 + x * 4, 20 + y * 3)
	body.Position = UDim2.fromOffset(24 - x * 3, 108 - y * 2)
	sidebar.Position = UDim2.fromOffset(-x * 2, -y * 2)
	previewHolder.Position = UDim2.fromOffset(318 + x * 5, y * 3)
	brandMark.Rotation = x * 4
	importButton.Position = UDim2.new(1, -72 + x * 3, 0.5, y * 2)
	closeButton.Position = UDim2.new(1, -16 + x * 2, 0.5, y * 2)
end)

local loadedData

local function fromHex(hex)
	if typeof(hex) ~= "string" then return Color3.new(0, 0, 0) end
	hex = hex:gsub("#", "")
	if #hex ~= 6 then return Color3.new(0, 0, 0) end
	return Color3.fromRGB(tonumber(hex:sub(1, 2), 16) or 0, tonumber(hex:sub(3, 4), 16) or 0, tonumber(hex:sub(5, 6), 16) or 0)
end

local function clearCanvas()
	ownerTooltip.Visible = false
	for _, child in ipairs(canvas:GetChildren()) do
		if not child:IsA("UIAspectRatioConstraint") then child:Destroy() end
	end
end

local function ownerText(action)
	local playerData = loadedData and loadedData.player or {}
	local username = action and action.username or playerData.username
	local displayName = action and action.displayName or playerData.displayName
	local userId = action and action.userId or playerData.userId
	if not username and not userId then return nil end
	if displayName and username and displayName ~= username then
		return string.format("Drawn by %s (@%s)  ?? User ID %s", tostring(displayName), tostring(username), tostring(userId or "Unknown"))
	end
	return string.format("Drawn by @%s  ?? User ID %s", tostring(username or "Unknown"), tostring(userId or "Unknown"))
end

local function attachOwner(guiObject, action)
	local text = ownerText(action)
	if not text then return end
	guiObject.Active = true
	guiObject.MouseEnter:Connect(function()
		ownerTooltip.Text = text
		ownerTooltip.Visible = true
	end)
	guiObject.MouseLeave:Connect(function()
		if ownerTooltip.Text == text then ownerTooltip.Visible = false end
	end)
end

local function pointXY(point, width, height)
	return (point.x or point[1] or 0) * width, (point.y or point[2] or 0) * height
end

local function segment(first, second, thickness, color, zIndex, width, height, action)
	local x1, y1 = pointXY(first, width, height)
	local x2, y2 = pointXY(second, width, height)
	local dx, dy = x2 - x1, y2 - y1
	local length = math.sqrt(dx * dx + dy * dy)
	local line = create("Frame", canvas, {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
		Size = UDim2.fromOffset(math.max(thickness, length + thickness), thickness), Rotation = math.deg(math.atan2(dy, dx)),
		BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = zIndex,
	})
	create("UICorner", line, {CornerRadius = UDim.new(1, 0)})
	attachOwner(line, action)
end

local function render()
	clearCanvas()
	if not loadedData then return end
	local absolute = canvas.AbsoluteSize
	local width, height = math.max(1, absolute.X), math.max(1, absolute.Y)
	local sourceWidth = loadedData.canvas and loadedData.canvas.width or 1000
	local scale = width / sourceWidth
	for index, action in ipairs(loadedData.actions or {}) do
		local kind = action.kind
		local z = math.min(index + 1, 8000)
		if kind == "clear" then
			clearCanvas()
		elseif kind == "fill" then
			local fill = create("Frame", canvas, {Size = UDim2.fromScale(1, 1), BackgroundColor3 = fromHex(action.color), BorderSizePixel = 0, ZIndex = z})
			attachOwner(fill, action)
		else
			local points = action.points or {}
			local thickness = math.max(1, (action.size or 8) * scale)
			local color1 = kind == "erase" and Color3.new(1, 1, 1) or fromHex(action.color)
			if kind == "rectangle" and #points >= 2 then
				local a, b = points[1], points[2]
				local c, d = {x = b.x, y = a.y}, {x = a.x, y = b.y}
				segment(a, c, thickness, color1, z, width, height, action); segment(c, b, thickness, color1, z, width, height, action)
				segment(b, d, thickness, color1, z, width, height, action); segment(d, a, thickness, color1, z, width, height, action)
			elseif kind == "ellipse" and #points >= 2 then
				local x1, y1 = pointXY(points[1], width, height)
				local x2, y2 = pointXY(points[2], width, height)
				local shape = create("Frame", canvas, {
					Position = UDim2.fromOffset(math.min(x1, x2), math.min(y1, y2)),
					Size = UDim2.fromOffset(math.max(thickness, math.abs(x1 - x2)), math.max(thickness, math.abs(y1 - y2))),
					BackgroundTransparency = 1, ZIndex = z,
				})
				create("UICorner", shape, {CornerRadius = UDim.new(1, 0)})
				create("UIStroke", shape, {Color = color1, Thickness = thickness})
				attachOwner(shape, action)
			elseif #points == 1 then
				segment(points[1], points[1], thickness, color1, z, width, height, action)
			else
				local total, traveled = 0, 0
				if kind == "gradient" then
					for pointIndex = 2, #points do
						local ax, ay = pointXY(points[pointIndex - 1], width, height)
						local bx, by = pointXY(points[pointIndex], width, height)
						total += math.sqrt((bx - ax) ^ 2 + (by - ay) ^ 2)
					end
				end
				local color2 = fromHex(action.color2)
				for pointIndex = 2, #points do
					local a, b = points[pointIndex - 1], points[pointIndex]
					local ax, ay = pointXY(a, width, height); local bx, by = pointXY(b, width, height)
					local distance = math.sqrt((bx - ax) ^ 2 + (by - ay) ^ 2)
					local color = color1
					if kind == "gradient" and total > 0 then color = color1:Lerp(color2, (traveled + distance / 2) / total) end
					segment(a, b, thickness, color, z, width, height, action)
					traveled += distance
				end
			end
		end
	end
end

local renderQueued = false
canvas:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
	if not loadedData or renderQueued then return end
	renderQueued = true
	task.defer(function() renderQueued = false; render() end)
end)

local function loadFile()
	status.Text = "Opening file picker..."
	local ok, fileOrError = pcall(StudioService.PromptImportFileAsync, StudioService, {"txt"})
	if not ok then status.Text = "Could not open file picker: " .. tostring(fileOrError); return end
	local file = fileOrError
	if not file then status.Text = "No file selected."; return end
	local readOk, contents = pcall(file.GetBinaryContents, file)
	file:Destroy()
	if not readOk then status.Text = "Could not read the selected TXT."; return end
	local decodeOk, data = pcall(HttpService.JSONDecode, HttpService, contents)
	if not decodeOk or typeof(data) ~= "table" or data.format ~= "RobloxWhiteboard/v1" then
		status.Text = "Invalid whiteboard TXT format."
		return
	end
	loadedData = data
	canvas.Visible = true
	emptyState.Visible = false
	local playerData = data.player or {}
	local sessionData = data.session or {}
	local placeData = data.place or {}
	local started = sessionData.startedAt and os.date("!%Y-%m-%d %H:%M:%S UTC", sessionData.startedAt) or "Unknown"
	local ended = sessionData.endedAt and os.date("!%Y-%m-%d %H:%M:%S UTC", sessionData.endedAt) or "Unknown"
	info.Text = string.format(
		"Username: @%s\nDisplay name: %s\nUser ID: %s\nPlace ID: %s\nStarted: %s\nEnded: %s",
		tostring(playerData.username or "Unknown"), tostring(playerData.displayName or "Unknown"), tostring(playerData.userId or "Unknown"),
		tostring(placeData.placeId or "Unknown"), started, ended
	)
	local drawingActions = data.actions or {}
	status.Text = "Loaded successfully. Reconstructed preview shown below."
	footer.Text = string.format("%d actions - %s", #drawingActions, tostring(sessionData.reason or "Unknown exit reason"))
	local canvasData = data.canvas or {}
	currentAspect = (canvasData.width or 1000) / math.max(1, canvasData.height or 823)
	fitCanvas()
	task.defer(render)
end

importButton.Activated:Connect(loadFile)
local function setViewerOpen(isOpen)
	widget.Enabled = isOpen
	toolbarButton:SetActive(isOpen)
end
closeButton.Activated:Connect(function() setViewerOpen(false) end)
toolbarButton.Click:Connect(function() setViewerOpen(not widget.Enabled) end)
widget:GetPropertyChangedSignal("Enabled"):Connect(function()
	toolbarButton:SetActive(widget.Enabled)
end)
plugin.Unloading:Connect(function()
	if widget then widget:Destroy() end
end)

]]></ProtectedString>
