local body = create("Frame", root, {
	Position = UDim2.fromOffset(24, 108), Size = UDim2.new(1, -48, 1, -132), BackgroundTransparency = 1,
})
local sidebar = create("Frame", body, {
	Size = UDim2.new(0, 300, 1, 0), BackgroundColor3 = Color3.fromRGB(16, 22, 32), BackgroundTransparency = 0.04, BorderSizePixel = 0,
})
create("UICorner", sidebar, {CornerRadius = UDim.new(0, 16)})
create("UIStroke", sidebar, {Color = Color3.fromRGB(52, 63, 81), Transparency = 0.4, Thickness = 1})
create("TextLabel", sidebar, {
